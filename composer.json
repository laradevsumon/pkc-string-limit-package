{
    "name": "pkc/word-limit",
    "description": "A Laravel package to limit and truncate words in strings with configurable options",
    "autoload": {
        "psr-4": {
            "Pkc\\WordLimit\\": "./src/"
        }
    },
    "authors": [
        {
            "name": "Roktim Ariyan",
            "email": "laradev.sumon@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "illuminate/support": ">=5.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pkc\\WordLimit\\WordLimitServiceProvider"
            ]
        }
    }
}